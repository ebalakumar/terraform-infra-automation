/// Common types, utilities, and validation functions for infrastructure configuration
module config.schemas.common

/// Valid AWS regions for our infrastructure
typealias AwsRegion = "us-east-1"|"us-west-1"|"us-west-2"|"eu-west-1"|"eu-central-1"

/// Valid environments for deployment
typealias Environment = "dev"|"qa"|"prod"

/// Valid EC2 instance types (commonly used ones)
typealias Ec2InstanceType = "t3.micro"|"t3.small"|"t3.medium"|"t3.large"|"t2.micro"|"t2.small"|"t2.medium"

/// Valid AMI ID pattern (AWS AMI IDs start with ami-)
typealias AmiId = String(matches(Regex(#"ami-[a-f0-9]{8,17}"#)))

/// Valid S3 bucket name pattern
typealias S3BucketName = String(
  matches(Regex(#"^[a-z0-9][a-z0-9-]*[a-z0-9]$"#)) && 
  length >= 3 && 
  length <= 63 &&
  !contains("..")
)

/// Valid SSH key name pattern
typealias SshKeyName = String(
  matches(Regex(#"^[a-zA-Z0-9-_]+$"#)) && 
  length >= 1 && 
  length <= 255
)

/// Validation function for team names
function isValidTeamName(name: String): Boolean = 
  name.matches(Regex(#"^team[1-9][0-9]*$"#))

/// Validation function for terraform state key pattern
function isValidStateKey(key: String): Boolean = 
  key.matches(Regex(#"^[a-zA-Z0-9/_-]+\.tfstate$"#))