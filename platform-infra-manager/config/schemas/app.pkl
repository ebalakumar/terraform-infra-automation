module config.schemas.app

import "common.pkl"

class AppConfig {
  instanceType: common.Ec2InstanceType
  amiId: common.AmiId
  keyName: common.SshKeyName
  bucketName: common.S3BucketName?
  tags: Mapping<String, String> = new {}
  securityGroups: Listing<String> = new {}
  subnetId: String?
}

function validateAppConfig(config: AppConfig, environment: common.Environment): Boolean =
  if (environment == "prod") 
    config.instanceType != "t3.micro" && config.instanceType != "t2.micro"
  else 
    true