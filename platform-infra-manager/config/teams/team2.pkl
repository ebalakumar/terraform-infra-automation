
module config.teams.team2

extends "../base.pkl"

dev {
  bucket = "my-terraform-team2-dev"
  instanceType = "t3.micro"
  amiId = "ami-12345678"
  keyName = "team2-dev-key"
}

qa {
  bucket = "my-terraform-team2-qa"
  instanceType = "t3.small"
  amiId = "ami-12345678"
  keyName = "team2-qa-key"
}

prod {
  bucket = "my-terraform-team2-prod"
  instanceType = "t3.large"
  amiId = "ami-12345678"
  keyName = "team2-prod-key"
}