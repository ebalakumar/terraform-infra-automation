
module config.teams.team3

extends "../base.pkl"

dev {
  bucket = "my-terraform-team3-dev"
  instanceType = "t3.micro"
  amiId = "ami-12345678"
  keyName = "team3-dev-key"
}

qa {
  bucket = "my-terraform-team3-qa"
  instanceType = "t3.small"
  amiId = "ami-12345678"
  keyName = "team3-qa-key"
}

prod {
  bucket = "my-terraform-team3-prod"
  instanceType = "t3.medium"
  amiId = "ami-12345678"
  keyName = "team3-prod-key"
}